{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "zh_CN",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "QuizKing · 答题王",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "capture-selection": {
      "suggested_key": { "default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q" },
      "description": "抓取当前选区文本并发送给 LLM（先在页面选中文字）"
    },
    "capture-visible": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "Command+Shift+E" },
      "description": "截图当前可见区域，可拖框裁剪后发给多模态 LLM"
    },
    "capture-page": {
      "suggested_key": { "default": "Ctrl+Shift+P", "mac": "Command+Shift+P" },
      "description": "抓取整页可读文本（document.innerText 前 6000 字符）"
    },
    "toggle-bubble": {
      "suggested_key": { "default": "Ctrl+Shift+H", "mac": "Command+Shift+H" },
      "description": "显示或隐藏右下角答题气泡；按一次显示，再按一次收起"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["bubble.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
